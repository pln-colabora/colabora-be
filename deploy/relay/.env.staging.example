# Copy to /opt/colabora-relay-staging/.env and chmod 600.
RELAY_CONTAINER_PREFIX=colabora-relay-staging
APP_NETWORK_NAME=colabora-be-staging_app-network

# Pin these to reviewed releases before deployment; do not use floating tags.
RELAY_IMAGE=hyvor/relay:latest
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:latest
RELAY_POSTGRES_TAG=18
RELAY_DB_PORT=15433

RELAY_POSTGRES_PASSWORD=replace-with-random-secret
AUTHENTIK_PG_PASSWORD=replace-with-random-secret
AUTHENTIK_SECRET_KEY=replace-with-random-secret

WEB_URL=http://relay.anargya.fun
INSTANCE_DOMAIN=mail-relay.anargya.fun
OIDC_ISSUER_URL=https://auth.anargya.fun/application/o/relay/
OIDC_CLIENT_ID=replace-with-authentik-client-id
OIDC_CLIENT_SECRET=replace-with-authentik-client-secret
DATABASE_URL=postgresql://postgres:replace-with-relay-password@127.0.0.1:15433/hyvor_relay?serverVersion=18&charset=utf8
APP_ENV=prod
LOG_LEVEL=info
