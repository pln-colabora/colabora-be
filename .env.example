# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# App
APP_NAME=colabora-be
APP_ENV=localhost           # "localhost" binds 0.0.0.0:$GOLANG_PORT; anything else binds :$GOLANG_PORT
GOLANG_PORT=8888
NGINX_PORT=81                # only used by docker-compose's nginx service

# Database (PostgreSQL)
DB_HOST=localhost
DB_USER=user
DB_PASS=password
DB_NAME=db
DB_PORT=5432

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Email (Resend SMTP) — requires a verified sending domain in Resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USERNAME=resend
SMTP_SENDER_NAME=COLABORA
# Use an address on a domain verified in Resend, e.g. noreply@mail.example.com.
SMTP_FROM_EMAIL=noreply@your-verified-domain.com
RESEND_API_KEY=re_your_api_key

# Email notifications — workflow PIC notifications are queued transactionally,
# then the server retries failed SMTP deliveries automatically.
# SLA reminders run every minute and are sent once at H-1 and H+1 (Asia/Jakarta).

# Storage (Garage, S3-compatible) — evidence document uploads, see PHASE5_DOCUMENTS.md.
# GARAGE_RPC_SECRET: generate with `openssl rand -hex 32`, used only by the garage
# container itself (docker-compose.yml), not by the app.
# GARAGE_S3_ENDPOINT: http://localhost:3900 when the app runs on-host via `make run`
# (docker-compose.yml publishes the port for this, same reasoning as DB_PORT); use
# http://garage:3900 instead in docker-compose.prod.yml, where the app is itself a
# container on the same app-network.
# GARAGE_ACCESS_KEY / GARAGE_SECRET_KEY: printed by `garage key create` during the
# one-time bootstrap described in PHASE5_DOCUMENTS.md — paste them here after.
GARAGE_RPC_SECRET=change-me-generate-with-openssl-rand-hex-32
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_REGION=garage
GARAGE_BUCKET=colabora-documents
GARAGE_ACCESS_KEY=change-me-after-bootstrap
GARAGE_SECRET_KEY=change-me-after-bootstrap

# Optional synchronous ClamAV daemon endpoint. When configured, scanner errors
# reject uploads; when omitted, provenance records scan_status=not_scanned.
CLAMAV_ADDRESS=
# `--script:cleanup_orphan_documents` removes older unattached uploads.
DOCUMENT_ORPHAN_TTL_HOURS=24
