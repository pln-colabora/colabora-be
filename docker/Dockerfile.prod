FROM golang:1.26-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
COPY third_party ./third_party
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /app/bin/server ./cmd/main.go

FROM alpine:3.20
WORKDIR /app

RUN apk add --no-cache ca-certificates && \
    addgroup -S app && adduser -S app -G app

COPY --from=builder /app/bin/server ./server
COPY --from=builder /app/docs/*.yaml ./docs/
COPY --from=builder /app/database/seeders/json ./database/seeders/json
RUN mkdir -p ./assets && chown -R app:app /app

USER app
EXPOSE 8888

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- "http://localhost:${GOLANG_PORT:-8888}/health" || exit 1

CMD ["./server"]
